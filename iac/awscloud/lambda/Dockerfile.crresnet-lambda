# Build from the repo root: docker build -f iac/awscloud/lambda/Dockerfile.crresnet-lambda .
FROM tensorflow/tensorflow:2.21.0

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /usr/local/bin/uv

# tensorflow and numpy are already in the base image
RUN uv pip install --system --no-cache \
    awslambdaric \
    boto3 \
    scikit-image==0.26.0 \
    opencv-python-headless==5.0.0.93

ENV LAMBDA_TASK_ROOT=/var/task \
    TF_CPP_MIN_LOG_LEVEL=3 \
    KERAS_HOME=/var/task/.keras

WORKDIR ${LAMBDA_TASK_ROOT}
COPY iac/awscloud/lambda/crresnet-lambda.py imagenet_class_index.json ./

# Lambda file system is read-only, so the pretrained model must be in the image.
RUN python -c 'from tensorflow.keras.applications import ResNet50; ResNet50(weights="imagenet")' \
    && chmod -R a+rX ${LAMBDA_TASK_ROOT}

ENTRYPOINT ["python", "-m", "awslambdaric"]
# default handler, the template overrides it with ImageConfig.Command
CMD ["crresnet-lambda.lambda_handler"]
