#!/bin/bash

## project version
export VERSION=1.0.0

## resnet50 server parameters:
export RESNET_SERVER_HOST=localhost
export RESNET_SERVER_PORT=8005
export RESNET_PREDICT_PATH=/api/v1/predict

## cloud parameters
export AWS_RESOURCE_CFN_ECR_STACK_NAME=crresnet-bvv-ecr
export AWS_RESOURCE_CFN_WEREWOLF_STACK_NAME=werewolf-bvv-cf-resource
export AWS_RESOURCE_CFN_STACK_NAME=crresnet-bvv-cf-resource
export AWS_RESOURCE_CDK_STACK_NAME=crresnet-bvv-resource

## folders
## absolute path of the project folder
export PROJECTFOLDER=
## relative to project folder, mounted by resnet50-compose.yaml as ${PROJECTFOLDER}/${LOCAL_IMAGES_FOLDER}
export LOCAL_IMAGES_FOLDER=test-image
## local storage folders
export LOCAL_STORAGE_FOLDER=local-storage
## objects storage placement
export IMAGE_STORAGE_FOLDER=image
export ADVERSARIAL_STORAGE_FOLDER=adversarial
export FILTER_STORAGE_FOLDER=filter
## store objects subfolders
## unquoted: .env is also parsed by `include` in the Makefile, which does not strip quotes
export IMAGE_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${IMAGE_STORAGE_FOLDER}
export ADVERSARIAL_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${ADVERSARIAL_STORAGE_FOLDER}
export FILTER_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${FILTER_STORAGE_FOLDER}
export DOWNLOADS_LOCAL_FOLDER=${PROJECTFOLDER}/${DOWNLOADS_OBJECTS_FOLDER}

